# Copy to .env and adjust. Read on the first start to write ~/.credits/config.ini; after that,
# config.ini is the source of truth (edit it directly).

# image tag: a release version (4.2.532-community.3) or latest
CREDITS_VERSION=latest
# host directory with the data, configuration and keys
CREDITS_HOME=~/.credits

# pruned (recent blocks only, starts from a snapshot) or full (every block, syncs from block 0)
CREDITS_STORAGE=pruned
# block database: lmdb (default for pruned), berkeleydb (default for full), rocksdb
#CREDITS_DB_BACKEND=
# pruned only: auto restores the latest snapshot into an empty data directory, off syncs from block 0
CREDITS_SNAPSHOT=auto
#CREDITS_SNAPSHOT_URL=https://github.com/EnzinoBB/node/releases/download/pruned-snapshot/latest.json

# p2p port, TCP and UDP; open it in the firewall
CREDITS_P2P_PORT=9510
# on: the Thrift API on 127.0.0.1:9090 of this host
CREDITS_API=off
# the contract executor (needed to take part in consensus as a trusted node)
CREDITS_EXECUTOR=on

# set to 1 once to move the current data aside (~/.credits/old-<date>) and start over,
# e.g. after changing pruned to full or the block database; then remove it
#CREDITS_RESET=1
