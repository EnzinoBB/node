--- a/third-party/blake2/CMakeLists.txt
+++ b/third-party/blake2/CMakeLists.txt
@@ -2,6 +2,18 @@
 
 project (blake2)
 
+# not x86 (Apple Silicon, ARM servers): the portable reference implementation of BLAKE2s, the
+# only one the node uses (same output); BLAKE2b would clash with libsodium's reference code
+if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|i.86|x86)$")
+  add_library(blake2
+    ref/blake2-impl.h
+    ref/blake2.h
+    ref/blake2s-ref.c )
+  target_include_directories(blake2 PUBLIC ref)
+  set_target_properties(blake2 PROPERTIES POSITION_INDEPENDENT_CODE ON)
+  return()
+endif()
+
 if (MSVC)
   add_definitions(-D__SSE4_1__)
 else()
